rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['uid', 'timestamp', 'fund', 'type', 'amount', 'balanceAfter']) &&
             data.uid is string &&
             data.fund in ['SYP', 'USD'] &&
             data.type in ['deposit', 'withdrawal', 'expense'] &&
             data.amount is number &&
             data.balanceAfter is number &&
             data.note is string &&
             data.note.size() < 500;
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.uid == request.auth.uid && 
                      isValidTransaction(request.resource.data);
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
    
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
